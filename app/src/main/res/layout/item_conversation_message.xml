<?xml version="1.0" encoding="utf-8"?>
<!--
    A single message row inside a conversation thread.
    Simpler than item_message.xml — no sender name (it's the same person
    throughout), just body + timestamp + optional lock icon.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_card_rounded"
    android:elevation="1dp"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/convLockIcon"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginEnd="6dp"
            android:src="@drawable/ic_lock_small"
            android:visibility="gone" />

        <TextView
            android:id="@+id/convBodyText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_primary"
            android:textSize="18sp"
            android:lineSpacingExtra="3dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/convTimeText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="end"
        android:textColor="@color/text_hint"
        android:textSize="11sp" />

</LinearLayout>